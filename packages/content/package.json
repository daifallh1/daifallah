{
  "name": "@itil5/content",
  "version": "1.0.0",
  "private": true,
  "description": "Audited, immutable question bank derived from 'ITIL Foundation 11-05-26.pdf' plus Arabic overlay. Generated by tools/; do not hand-edit build/.",
  "files": [
    "build",
    "syllabus",
    "reports"
  ],
  "exports": {
    "./bank.json": "./build/bank.json",
    "./translations.ar.json": "./build/translations.ar.json",
    "./import-audit.json": "./reports/import-audit.json",
    "./translation-coverage.json": "./reports/translation-coverage.json",
    "./pages.json": "./source/pages.json",
    "./build/*": "./build/*",
    "./reports/*": "./reports/*"
  }
}
