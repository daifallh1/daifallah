{
  "name": "@itil5/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "node scripts/serve.mjs out 4173",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings 0",
