    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@itil5/content": "1.0.0",
    "@itil5/core": "1.0.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "typescript": "5.6.3"
  }
}
