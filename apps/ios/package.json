{
  "name": "@itil5/ios",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "echo 'shared logic is tested in @itil5/core; run npm run export:ios to compile the iOS bundle'",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:web": "expo export --platform web --output-dir dist/web",
    "build:ipa": "bash scripts/build-ipa.sh",
    "smoke:simulator": "bash scripts/simulator-smoke.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "4.0.1",
    "@itil5/content": "1.0.0",
    "@itil5/core": "1.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "7.2.0",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "expo": "52.0.49",
    "expo-status-bar": "2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-web": "0.19.13"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
