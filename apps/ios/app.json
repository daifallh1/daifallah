{
  "expo": {
    "name": "ITIL v5 Practice",
    "slug": "itil5-foundation-practice",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "web"
    ],
    "splash": {
      "backgroundColor": "#1d47b8",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.daifallah.itil5foundation",
      "supportsTablet": true,
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
